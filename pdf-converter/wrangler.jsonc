// The PDF converter for WaterCare certificates (needs the Workers Paid plan and Docker running for deploy).
// Deploy from this folder, before the main Worker:  npm install && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watercare-pdf",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Not reachable from the internet; the main Worker calls it through the "PDF" service binding.
  "workers_dev": false,
  "containers": [
    {
      "class_name": "PdfConverter",
      "image": "./Dockerfile",
      // 1/4 vCPU, 1 GiB: enough for LibreOffice and inside the plan's included container hours for normal use.
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PDF_CONVERTER", "class_name": "PdfConverter" }
    ]
  },
  "exports": {
    "PdfConverter": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": true }
}
