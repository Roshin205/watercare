// WaterCare on Cloudflare: Python Worker (Flask) + D1 + R2 + the PDF converter container (pdf-converter/).
// Deploy: uv run pywrangler deploy   ·   Local: uv run pywrangler dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watercare",
  "main": ".worker-build/worker.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  // Copies only the app's code, templates and static files into .worker-build/ before every dev run and deploy.
  "build": {
    "command": "python scripts/build_worker.py",
    "watch_dir": ["backend", "templates", "static", "cloudflare"]
  },
  // /static/... is served straight from Cloudflare's asset storage; every other path runs the Flask app.
  "assets": {
    "directory": ".worker-build/assets"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watercare",
      // Created with: npx wrangler d1 create watercare (region APAC)
      "database_id": "220190cb-9556-4c3d-9daa-43f6521ca37e",
      "migrations_dir": "d1-migrations"
    }
  ],
  "r2_buckets": [
    {
      // Private bucket: files are only served through the app's signed-in routes.
      "binding": "FILES",
      "bucket_name": "watercare-files"
    }
  ],
  "services": [
    {
      // Certificate PDFs: the LibreOffice container Worker in pdf-converter/ (deploy it first).
      "binding": "PDF",
      "service": "watercare-pdf"
    }
  ],
  "observability": {
    "enabled": true
  }
}
